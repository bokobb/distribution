# Скопируйте в .env и заполните. .env в git не попадает.
# Его читают и docker compose (база), и сервер (spring.config.import в application.properties).

# База PostgreSQL
DB_USER=distribution
DB_PASSWORD=
# DB_URL=jdbc:postgresql://127.0.0.1:5436/distribution

# Первый владелец (SUPER_ADMIN): создаётся при запуске, если владельца в базе ещё нет.
# Телефон — в любом виде (+7 701 …, 8701…), вход по нему.
OWNER_PHONE=
OWNER_PASSWORD=

# Профиль demo: пароль всех демо-сотрудников (без него демо-данные не создаются).
DEMO_PASSWORD=
